# Bloqueio de segurança: arquivos de configuração, logs e diretórios internos
<FilesMatch "^(config.*\.php|\.env.*|\.git.*|.*\.log|.*\.jsonl)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Força HTTPS e domínio sem www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://samiranunes.com/$1 [L,R=301]

# Bloquear acesso direto a diretórios internos
RewriteRule ^(ratelimit|storage|apps-script)(/.*)?$ - [F,L,NC]

# /index.html vira /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# /blog/index.html vira /blog/
RewriteCond %{THE_REQUEST} \s/blog/index\.html[\s?] [NC]
RewriteRule ^blog/index\.html$ /blog/ [L,R=301]

# Endereço antigo do blog
Redirect 301 /blog.html /blog/

# Página de erro
ErrorDocument 404 /404.html
